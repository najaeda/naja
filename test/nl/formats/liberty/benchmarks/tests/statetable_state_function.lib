library (statetable_state_function_test) {
  type (bus_1_0) {
    base_type : array;
    data_type : bit;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0;
    downto : true;
  }
  cell (ICG) {
    clock_gating_integrated_cell : latch_posedge_precontrol;
    statetable ("CLK ENA SE", "IQ") {
      table : "L L L : - : L,
               L L H : - : H,
               L H L : - : H,
               L H H : - : H,
               H - - : - : N";
    }
    pin (IQ) {
      direction : internal;
      internal_node : "IQ";
    }
    pin (GCLK) {
      direction : output;
      state_function : "CLK & IQ";
      timing () {
        related_pin : "CLK";
        timing_type : combinational_fall;
      }
      timing () {
        related_pin : "CLK";
      }
    }
    pin (CLK) {
      direction : input;
    }
    pin (ENA) {
      direction : input;
      timing () {
        related_pin : "CLK";
        timing_type : hold_rising;
      }
      timing () {
        related_pin : "CLK";
        timing_type : setup_rising;
      }
    }
    pin (SE) {
      direction : input;
      timing () {
        related_pin : "CLK";
        timing_type : hold_rising;
      }
      timing () {
        related_pin : "CLK";
        timing_type : setup_rising;
      }
    }
  }
  cell (STATE_FUNCTION_ONLY) {
    pin (D) {
      direction : input;
    }
    pin (Q) {
      direction : output;
      function : "D";
      state_function : "D";
    }
  }
  cell (STATE_RISING_OUTPUT) {
    pin (CLK) {
      direction : input;
    }
    pin (D) {
      direction : input;
    }
    pin (Q) {
      direction : output;
      state_function : "IQ";
      timing () {
        related_pin : "CLK";
        timing_type : rising_edge;
      }
    }
  }
  cell (STATE_BUS_TIMING) {
    statetable ("ENABLE", "IQ") {
      table : "L : - : L,
               H : - : H";
    }
    pin (IQ) {
      direction : internal;
      internal_node : "IQ";
    }
    pin (ENABLE) {
      direction : input;
    }
    bus (D) {
      bus_type : bus_1_0;
      direction : input;
    }
    bus (Q) {
      bus_type : bus_1_0;
      direction : output;
      timing () {
        related_pin : "D";
        timing_type : combinational_rise;
      }
      timing () {
        timing_type : combinational_fall;
      }
    }
  }
  cell (FF_WITH_STATE_FUNCTION) {
    ff (IQ, IQN) {
      clocked_on : "CLK";
      next_state : "D";
    }
    pin (CLK) {
      direction : input;
    }
    pin (D) {
      direction : input;
      timing () {
        related_pin : "CLK";
        timing_type : setup_rising;
      }
    }
    pin (Q) {
      direction : output;
      function : "IQ";
      state_function : "IQ";
      timing () {
        related_pin : "CLK";
        timing_type : rising_edge;
      }
    }
  }
}
