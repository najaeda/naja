library (example) {
  cell (synthetic_bundle_cell) {
    bundle (internal_data) {
      members (temporary_0, temporary_1, temporary_2);
      direction : internal;
    }
    pin (clock) {
      clock : true;
      direction : input;
    }
    pin (enable) {
      direction : input;
    }
  }
}
