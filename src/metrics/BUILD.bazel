# Mirrors this directory's own CMakeLists.txt: builds the `naja_metrics`
# library. See internal/bazel-migration-plan.md (Phase 4, task #18).

load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "naja_metrics",
    srcs = [
        "FanoutComputer.cpp",
        "LogicCone.cpp",
        "LogicLevelComputer.cpp",
    ],
    hdrs = [
        "FanoutComputer.h",
        "LogicCone.h",
        "LogicLevelComputer.h",
    ],
    copts = select({
        "@platforms//os:macos": ["-Wno-sign-conversion"],
        "//conditions:default": [],
    }),
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//src/bne:naja_bne",
        "//src/dnl:naja_dnl",
        "@spdlog",
    ],
)
