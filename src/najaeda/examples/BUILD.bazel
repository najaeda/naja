load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Bazel equivalent of .github/workflows/najaeda-examples.yml: runs
# run_regress.py, which walks its own cwd's immediate subdirectories and
# executes every *.py example script in each (task #28).

filegroup(
    name = "examples_sources",
    srcs = glob(
        ["**/*.py"],
        exclude = ["**/__pycache__/**"],
    ),
)

sh_test(
    name = "najaeda_examples",
    srcs = ["run_najaeda_examples.sh"],
    args = [
        "src/najaeda/najaeda",
        "$(rootpath //src/nl/python/naja_wrapping:naja.so)",
        "$(rootpath //src/nl/python/naja_wrapping:naja_runtime)",
        "$(PYTHON3_ROOTPATH)",
        "src/najaeda/examples",
    ],
    toolchains = ["@rules_python//python:current_py_toolchain"],
    data = [
        ":examples_sources",
        "//src/najaeda/benchmarks",
        "//src/najaeda/najaeda:sources",
        "//src/nl/python/naja_wrapping:naja.so",
        "//src/nl/python/naja_wrapping:naja_runtime",
        "@rules_python//python:current_py_toolchain",
    ],
    # Not gtest/ctest-shaped output; run_regress.py's own logging is the
    # useful signal, and each example script can take a few seconds
    # (SystemVerilog/Verilog parsing) -- matches the ~3-minute
    # per-script timeout run_regress.py itself already enforces.
    timeout = "long",
)
