package phase0_types

top fn reshape(input: bits[8][2]) -> (bits[8], bits[8]) {
  zero: bits[1] = literal(value=0, id=2)
  one: bits[1] = literal(value=1, id=3)
  low: bits[8] = array_index(input, indices=[zero], assumed_in_bounds=true, id=4)
  high: bits[8] = array_index(input, indices=[one], assumed_in_bounds=true, id=5)
  ret result: (bits[8], bits[8]) = tuple(low, high, id=6)
}
