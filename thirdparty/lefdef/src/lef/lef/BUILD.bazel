# Mirrors this directory's own CMakeLists.txt: builds the `lef` static
# library naja actually links (src/nl/formats/lefdef/CMakeLists.txt).
# lef.tab.h is generated here, whereas def (in ../../def/def) uses a
# checked-in def.tab.h.

load("@bison//:bison.bzl", "bison")

# -p lefyy keeps yyparse/yylex from colliding with the def parser.
bison(
    name = "lef_parser",
    srcs = ["lef.y"],
    outs = [
        "lef_parser.cpp",
        "lef.tab.h",
    ],
    args = [
        "-Wconflicts-sr",
        "-p",
        "lefyy",
        "--output=$(execpath lef_parser.cpp)",
        "-d",
        "--defines=$(execpath lef.tab.h)",
        "$(execpath lef.y)",
    ],
)

cc_library(
    name = "lef",
    # -w: this is Cadence's vendored LEF reference parser (thirdparty/,
    # not naja's own code) -- silence its warnings wholesale rather than
    # fixing them one at a time, since naja doesn't maintain this source.
    copts = ["-w"],
    srcs = [
        ":lef_parser",
        "crypt.cpp",
        "lef_keywords.cpp",
        "lefiArray.cpp",
        "lefiCrossTalk.cpp",
        "lefiDebug.cpp",
        "lefiEncryptInt.cpp",
        "lefiLayer.cpp",
        "lefiMacro.cpp",
        "lefiMisc.cpp",
        "lefiNonDefault.cpp",
        "lefiProp.cpp",
        "lefiPropType.cpp",
        "lefiTBExt.cpp",
        "lefiUnits.cpp",
        "lefiVia.cpp",
        "lefiViaRule.cpp",
        "lefrCallbacks.cpp",
        "lefrData.cpp",
        "lefrReader.cpp",
        "lefrSettings.cpp",
        "lefwWriter.cpp",
        "lefwWriterCalls.cpp",
    ],
    hdrs = glob(["*.hpp"]) + ["lex.h"],
    includes = ["."],
    visibility = ["//visibility:public"],
)
