# Mirrors this directory's own CMakeLists.txt: builds the `def` static
# library naja actually links (src/nl/formats/lefdef/CMakeLists.txt).
# def.tab.h is an ordinary checked-in header here (not generated),
# unlike lef.tab.h in ../../lef/lef.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@bison//:bison.bzl", "bison")

# No --defines: def/def/*.cpp include the checked-in def.tab.h instead,
# matching CMake's BISON_TARGET, which names no DEFINES_FILE.
bison(
    name = "def_parser",
    srcs = ["def.y"],
    outs = ["def_parser.cpp"],
    args = [
        "-Wconflicts-sr",
        "-p",
        "defyy",
        "--output=$(execpath def_parser.cpp)",
        "$(execpath def.y)",
    ],
)

cc_library(
    name = "def",
    # -w: this is Cadence's vendored DEF reference parser (thirdparty/,
    # not naja's own code) -- silence its warnings wholesale rather than
    # fixing them one at a time, since naja doesn't maintain this source.
    copts = ["-w"],
    srcs = [
        ":def_parser",
        "def_keywords.cpp",
        "defiAlias.cpp",
        "defiAssertion.cpp",
        "defiBlockage.cpp",
        "defiComponent.cpp",
        "defiDebug.cpp",
        "defiFPC.cpp",
        "defiFill.cpp",
        "defiGroup.cpp",
        "defiIOTiming.cpp",
        "defiMisc.cpp",
        "defiNet.cpp",
        "defiNonDefault.cpp",
        "defiPartition.cpp",
        "defiPath.cpp",
        "defiPinCap.cpp",
        "defiPinProp.cpp",
        "defiProp.cpp",
        "defiPropType.cpp",
        "defiRegion.cpp",
        "defiRowTrack.cpp",
        "defiScanchain.cpp",
        "defiSite.cpp",
        "defiSlot.cpp",
        "defiTimingDisable.cpp",
        "defiUtil.cpp",
        "defiVia.cpp",
        "defrCallbacks.cpp",
        "defrData.cpp",
        "defrReader.cpp",
        "defrSettings.cpp",
        "defwWriter.cpp",
        "defwWriterCalls.cpp",
    ],
    hdrs = glob(["*.hpp"]) + [
        "def.tab.h",
        "lex.h",
    ],
    includes = ["."],
    visibility = ["//visibility:public"],
)
